{
  "name": "auditpro",
  "version": "1.0.0",
  "description": "Full-stack secure audit logging application with 3 isolated SQLite databases, JWT authentication, and an immutable audit trail",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "watch": "node watch-db.js",
    "migrate": "node migrations/runner.js up",
    "migrate:rollback": "node migrations/runner.js down",
    "migrate:status": "node migrations/runner.js status",
    "migrate:reset": "node migrations/runner.js reset"
  },
  "keywords": [
    "audit-logging",
    "sqlite",
    "jwt",
    "immutable-audit",
    "security",
    "compliance"
  ],
  "author": "AuditPro Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}
